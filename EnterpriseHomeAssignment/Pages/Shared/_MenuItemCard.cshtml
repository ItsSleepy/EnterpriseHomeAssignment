@model EnterpriseHomeAssignment.Models.MenuItem

<div class="card h-100">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="card-img-top" alt="@Model.Title" style="height: 200px; object-fit: cover;">
    }
    else
    {
        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
            <i class="bi bi-egg-fried text-white" style="font-size: 4rem;"></i>
        </div>
    }
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text">
            <strong>Price:</strong> @Model.Price.ToString("C")<br/>
            <strong>Restaurant:</strong> @Model.Restaurant?.Name<br/>
            <strong>Status:</strong> <span class="badge bg-success">@Model.Status</span>
        </p>
    </div>
</div>
